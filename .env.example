# Local development. Keep credentials out of version control.
APP_NAME=klowb
APP_VERSION=0.1.0
APP_ENV=dev
LOG_LEVEL=INFO
LOG_FORMAT=json

TRADING_MODE=research
LIVE_TRADING_ENABLED=false
LIVE_TRADING_ACK=
RISK_CONFIG_REVIEWED=false
# LIVE_BROKER_API_KEY=
# LIVE_BROKER_API_SECRET=

# Local-only development credentials used by scripts/dev_db_setup.sh.
DATABASE_URL=postgresql+asyncpg://klowb:klowb@localhost:5432/klowb
REDIS_URL=redis://localhost:6379/0
DEPENDENCY_CHECK_TIMEOUT_SECONDS=2
CORS_ALLOWED_ORIGINS=

LLM_ENABLED=false
# ANTHROPIC_API_KEY=
