        "open": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "gt": 0,
          "title": "Open"
        },
        "provider": {
          "pattern": "^[a-z][a-z0-9_]{1,31}$",
          "title": "Provider",
          "type": "string"
        },
        "provider_symbol": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[\\x21-\\x7e]+$",
          "title": "Provider Symbol",
          "type": "string"
        },
        "raw_payload_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Payload Hash",
          "type": "string"
        },
        "received_timestamp": {
          "format": "date-time",
          "title": "Received Timestamp",
          "type": "string"
        },
        "redistribution_allowed": {
          "default": false,
          "title": "Redistribution Allowed",
          "type": "boolean"
        },
        "sequence_number": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence Number"
        },
        "timeframe": {
          "$ref": "#/$defs/Timeframe"
