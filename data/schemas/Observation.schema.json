        "asset_class": {
          "$ref": "#/$defs/AssetClass"
        },
        "canonical_symbol": {
          "title": "Canonical Symbol",
          "type": "string"
        },
        "close": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "gt": 0,
          "title": "Close"
        },
        "currency": {
          "pattern": "^[A-Z0-9]{2,10}$",
          "title": "Currency",
          "type": "string"
        },
        "data_type": {
          "const": "BAR",
          "default": "BAR",
          "title": "Data Type",
          "type": "string"
        },
        "delay_seconds": {
          "default": 0,
          "minimum": 0,
          "title": "Delay Seconds",
          "type": "integer"
        },
        "entitlement": {
          "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,63}$",
          "title": "Entitlement",
          "type": "string"
        },
        "event_timestamp": {
          "format": "date-time",
          "title": "Event Timestamp",
          "type": "string"
        },
        "feed_quality": {
          "$ref": "#/$defs/FeedQuality"
        },
        "high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
