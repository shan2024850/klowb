      "enum": [
        "EQUITY",
        "ETF",
        "CRYPTO",
        "FX",
        "FUTURE",
        "OPTION"
      ],
      "title": "AssetClass",
      "type": "string"
    },
    "BarObservation": {
      "additionalProperties": false,
      "description": "OHLCV bar. ``event_timestamp`` is the interval START (UTC).",
